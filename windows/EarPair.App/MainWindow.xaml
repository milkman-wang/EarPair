<Window x:Class="EarPair.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:EarPair.App.Controls"
        xmlns:local="using:EarPair.App">

  <!-- 有 Mica 时代码里把背景换成透明；Windows 10 没有 Mica，用纯色背景 -->
  <Grid x:Name="Root" RowDefinitions="Auto,*" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
    <!-- 标题栏：图标 + 名字，右边“⋯”菜单，再右边是系统按钮（右边距在代码里按系统按钮的宽度设）。
         不用 WinUI 的 TitleBar 控件：它把系统按钮的宽度（物理像素）直接当成 DIP，缩放不是 100% 时右边空出一大块。 -->
    <Grid x:Name="AppTitleBar" Height="48" Padding="16,0,0,0" ColumnSpacing="12" ColumnDefinitions="Auto,*,Auto">
      <Image Source="ms-appx:///Assets/EarPair.png" Width="16" Height="16" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="EarPair" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
      <Button x:Name="MoreButton" Grid.Column="2" Width="40" Height="32" Padding="0" Margin="0,0,4,0"
              VerticalAlignment="Center" Style="{StaticResource SubtleButtonStyle}"
              ToolTipService.ToolTip="更多" AutomationProperties.Name="更多">
        <FontIcon Glyph="&#xE712;" FontSize="16" />
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedRight">
            <MenuFlyoutItem Text="打开日志文件夹" Click="OnOpenLogs">
              <MenuFlyoutItem.Icon>
                <FontIcon Glyph="&#xE838;" />
              </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="退出 EarPair" Click="OnQuit" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="720" Padding="24,8,24,24" Spacing="4">

        <!-- 主卡片：状态和开关、路线、提示条（在底部，出现时路线不跳） -->
        <Border Padding="24" Margin="0,0,0,12" CornerRadius="{StaticResource OverlayCornerRadius}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel>
            <StackPanel.ChildrenTransitions>
              <TransitionCollection>
                <RepositionThemeTransition />
              </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <Grid x:Name="StatusRow" MinHeight="40" ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock x:Name="StatusTitle" VerticalAlignment="Center"
                         Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.LiveSetting="Polite" />
              <ToggleSwitch x:Name="SendSwitch" Grid.Column="1" VerticalAlignment="Center"
                            AutomationProperties.Name="发送" Toggled="OnSendToggled" />
            </Grid>

            <controls:SignalPath x:Name="Route" Margin="0,24,0,0" />

            <!-- 还没选过 Mac：发现列表 -->
            <StackPanel x:Name="Picker" Visibility="Collapsed" Spacing="8">
              <Grid MinHeight="40" ColumnDefinitions="*,Auto">
                <TextBlock Text="选择 Mac" VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ProgressRing x:Name="PickerRing" Grid.Column="1" Width="16" Height="16" IsActive="True" />
                <Button x:Name="RescanButton" Grid.Column="1" Visibility="Collapsed" Click="OnRescan"
                        Style="{StaticResource SubtleButtonStyle}" Padding="8"
                        ToolTipService.ToolTip="重新查找" AutomationProperties.Name="重新查找">
                  <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
              </Grid>
              <ListView x:Name="MacList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnMacClicked"
                        Margin="-16,0">
                <ListView.ItemTemplate>
                  <DataTemplate x:DataType="local:MacListItem">
                    <Grid MinHeight="56" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
                          AutomationProperties.Name="{x:Bind Title}">
                      <Grid Width="40" Height="40" VerticalAlignment="Center">
                        <Ellipse Fill="{ThemeResource ControlAltFillColorQuarternaryBrush}" />
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" />
                      </Grid>
                      <TextBlock Grid.Column="1" Text="{x:Bind Title}" VerticalAlignment="Center"
                                 Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                      <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
              <StackPanel x:Name="EmptyState" Visibility="Collapsed" Spacing="8" Padding="0,16">
                <FontIcon Glyph="&#xE7F8;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="没有找到 Mac" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
              <HyperlinkButton Content="输入地址" Padding="0" Click="OnEnterAddress" />
            </StackPanel>

            <InfoBar x:Name="Notice" Margin="0,20,0,0" IsOpen="False" IsClosable="False" Visibility="Collapsed"
                     CloseButtonClick="OnNoticeClosed">
              <InfoBar.ActionButton>
                <Button x:Name="NoticeButton" Click="OnNoticeAction" />
              </InfoBar.ActionButton>
            </InfoBar>
          </StackPanel>
        </Border>

        <controls:SettingsRow x:Name="TargetRow" Glyph="&#xE7F8;" Header="发送到">
          <DropDownButton x:Name="TargetButton" Width="300" HorizontalContentAlignment="Left" AutomationProperties.Name="发送到"
                          SizeChanged="OnTargetButtonSizeChanged">
            <DropDownButton.Flyout>
              <MenuFlyout x:Name="TargetMenu" Placement="BottomEdgeAlignedRight" Opening="OnTargetMenuOpening" />
            </DropDownButton.Flyout>
          </DropDownButton>
        </controls:SettingsRow>

        <controls:SettingsRow Glyph="&#xE7F5;" Header="声音来源">
          <!-- 定宽：打开时选中项会挪进列表，不定宽的话框会缩到 MinWidth，列表就按缩小后的框定位，和原来的框对不上。
               列表默认按最长的设备名撑宽（还会伸出窗口），打开动画却是从框本身展开的；把每一项限制在框宽以内，
               列表就和框一样宽（WinUI 保证列表不窄于框），长名字截断、悬停看全名。
               288 = 框宽 300 − 列表边框 2 − 项左右外边距 5×2 -->
          <ComboBox x:Name="DeviceBox" Width="300" AutomationProperties.Name="声音来源" SelectionChanged="OnDeviceChanged">
            <ComboBox.ItemContainerStyle>
              <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
                <Setter Property="MaxWidth" Value="288" />
              </Style>
            </ComboBox.ItemContainerStyle>
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{x:Bind}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </controls:SettingsRow>

        <controls:SettingsRow Glyph="&#xE74F;" Header="发送时本机静音">
          <ToggleSwitch x:Name="MuteSwitch" AutomationProperties.Name="发送时本机静音" Toggled="OnMuteToggled" />
        </controls:SettingsRow>

        <controls:SettingsRow Glyph="&#xE7E8;" Header="开机时启动">
          <ToggleSwitch x:Name="StartupSwitch" AutomationProperties.Name="开机时启动" Toggled="OnStartupToggled" />
        </controls:SettingsRow>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
