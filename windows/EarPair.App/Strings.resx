    <value>Playing</value>
  </data>
  <data name="StatusSending" xml:space="preserve">
    <value>Sending</value>
  </data>
  <data name="PostMuteNotice" xml:space="preserve">
    <value>This device can't be captured while muted, so it was unmuted</value>
  </data>
  <data name="PathDescription" xml:space="preserve">
    <value>{0}: {1} to {2}</value>
    <comment>路线给屏幕阅读器的一句话。{0}：状态，{1}：这台电脑，{2}：Mac</comment>
  </data>
  <data name="PathDescriptionWithOutput" xml:space="preserve">
    <value>{0}: {1} to {2}, then {3}</value>
    <comment>{3}：Mac 的输出设备</comment>
  </data>

  <!-- 通知区域 -->
  <data name="TrayNoMac" xml:space="preserve">
    <value>No Mac chosen yet</value>
  </data>
  <data name="StartSending" xml:space="preserve">
    <value>Start sending</value>
  </data>
  <data name="StopSending" xml:space="preserve">
    <value>Stop sending</value>
  </data>
  <data name="OpenEarPair" xml:space="preserve">
    <value>Open EarPair</value>
  </data>
  <data name="Exit" xml:space="preserve">
    <value>Exit</value>
  </data>
  <data name="BackgroundTitle" xml:space="preserve">
    <value>EarPair is running in the background</value>
  </data>
  <data name="BackgroundText" xml:space="preserve">
    <value>Select the ear icon on the taskbar to open it again</value>
  </data>

  <!-- 日志 -->
  <data name="LogStarting" xml:space="preserve">
    <value>Starting EarPair {0} ({1}, {2})</value>
    <comment>{0}：版本，{1}：处理器架构，{2}：系统版本</comment>
  </data>
  <data name="LogStartingAtLogin" xml:space="preserve">
    <value>Starting EarPair {0} ({1}, {2}) at login</value>
  </data>
  <data name="LogRestoredMute" xml:space="preserve">
    <value>Restored this PC's sound, left muted last time</value>
  </data>
  <data name="LogPostMuteDevice" xml:space="preserve">
    <value>This device can't be captured while muted; it won't be muted again: {0}</value>
    <comment>{0}：设备 id</comment>
  </data>
  <data name="LogStartSending" xml:space="preserve">
    <value>Sending to {0} ({1}:{2})</value>
    <comment>{0}：Mac 的名字，{1}:{2}：地址和端口</comment>
  </data>
  <data name="LogStartSendingAnyway" xml:space="preserve">
    <value>Sending to {0} ({1}:{2}) anyway</value>
  </data>
  <data name="LogStopSending" xml:space="preserve">
    <value>Sending stopped</value>
  </data>
  <data name="LogAddressChanged" xml:space="preserve">
    <value>{0} changed address: {1} → {2}</value>
  </data>
  <data name="LogSessionEnding" xml:space="preserve">
    <value>Shutting down or signing out: stopping, restoring this PC's sound</value>
  </data>
  <data name="LogExit" xml:space="preserve">
    <value>Exiting</value>
  </data>
  <data name="LogUnhandled" xml:space="preserve">
    <value>Unhandled exception: 0x{0} {1}</value>
    <comment>{0}：HRESULT（十六进制），{1}：异常和调用栈</comment>
  </data>
  <data name="LogUnhandledBackground" xml:space="preserve">
    <value>Unhandled exception (background thread): {0}</value>
  </data>
</root>
