<?xml version="1.0" encoding="utf-8"?>
<!-- 界面文字（英文，原文）。中文在 Strings.zh-Hans.resx；术语见 docs/localization.md，Windows 一律用句首大写 -->
<root>
  <resheader name="resmimetype">
    <value>text/microsoft-resx</value>
  </resheader>
  <resheader name="version">
    <value>2.0</value>
  </resheader>
  <resheader name="reader">
    <value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <resheader name="writer">
    <value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>

  <data name="ControlLanguage" xml:space="preserve">
    <value>en-US</value>
    <comment>不是界面文字：WinUI 控件自带的文字（右键菜单等）用哪种语言，填这门语言的 BCP-47 代码</comment>
  </data>

  <!-- 主窗口 -->
  <data name="More" xml:space="preserve">
    <value>More</value>
  </data>
  <data name="OpenLogFolder" xml:space="preserve">
    <value>Open log folder</value>
  </data>
  <data name="ExitEarPair" xml:space="preserve">
    <value>Exit EarPair</value>
  </data>
  <data name="Send" xml:space="preserve">
    <value>Send</value>
    <comment>发送开关的无障碍名称</comment>
  </data>
  <data name="ChooseMac" xml:space="preserve">
    <value>Choose a Mac</value>
  </data>
  <data name="SearchAgain" xml:space="preserve">
    <value>Search again</value>
  </data>
  <data name="NoMacsFound" xml:space="preserve">
    <value>No Macs found</value>
  </data>
  <data name="EnterAddress" xml:space="preserve">
    <value>Enter address</value>
  </data>
  <data name="EnterAddressMenu" xml:space="preserve">
    <value>Enter address…</value>
    <comment>菜单项，会打开对话框</comment>
  </data>
  <data name="SendTo" xml:space="preserve">
    <value>Send to</value>
  </data>
  <data name="SoundSource" xml:space="preserve">
    <value>Sound source</value>
  </data>
  <data name="MuteWhileSending" xml:space="preserve">
    <value>Mute this PC while sending</value>
  </data>
  <data name="StartAtLogin" xml:space="preserve">
    <value>Start at login</value>
  </data>
  <data name="CannotMuteDevice" xml:space="preserve">
    <value>This device can't be captured while muted</value>
  </data>
  <data name="NameWithAddress" xml:space="preserve">
    <value>{0} ({1})</value>
    <comment>两台 Mac 重名时：{0}：名字，{1}：IP</comment>
  </data>
  <data name="SystemDefault" xml:space="preserve">
    <value>System default</value>
  </data>
  <data name="SystemDefaultDevice" xml:space="preserve">
    <value>System default ({0})</value>
    <comment>{0}：当前的默认输出设备</comment>
  </data>

  <!-- 输入地址对话框 -->
  <data name="AddressDialogTitle" xml:space="preserve">
    <value>Enter the Mac's address</value>
  </data>
  <data name="AddressNotFound" xml:space="preserve">
    <value>Can't find this address</value>
  </data>
  <data name="Connect" xml:space="preserve">
    <value>Connect</value>
  </data>
  <data name="Cancel" xml:space="preserve">
    <value>Cancel</value>
  </data>

  <!-- 主卡片的状态和提示条 -->
  <data name="StatusNotSending" xml:space="preserve">
    <value>Not sending</value>
  </data>
  <data name="StatusCantSend" xml:space="preserve">
