<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EarPair.Sender</AssemblyName>
    <RootNamespace>EarPair.Sender</RootNamespace>
    <!-- Strings.resx 是英文；中文在 Strings.zh-Hans.resx（卫星程序集，单文件发布时也打进去） -->
    <NeutralLanguage>en</NeutralLanguage>
    <Version>0.2.0</Version>
    <!-- 不能用 InvariantGlobalization：那样界面语言永远是英文，要按 Windows 的显示语言选中文或英文 -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 允许在 Mac / Linux 上编译检查（运行仍然需要 Windows） -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- dotnet publish -r win-x64 或 win-arm64：打成自带 .NET 运行时的单个 exe，Windows 上不用另装 .NET -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../EarPair.Sender.Core/EarPair.Sender.Core.csproj" />
  </ItemGroup>

</Project>
